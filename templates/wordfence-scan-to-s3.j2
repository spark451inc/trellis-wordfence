#!/usr/bin/env bash

set -u

if (($# != 1)); then
  printf 'Usage: %s {malware-scan|vuln-scan}\n' "$0" >&2
  exit 64
fi

readonly scan_type="$1"
readonly bucket={{ wordfence_s3_bucket | quote }}
readonly environment={{ env | quote }}
readonly prefix={{ wordfence_s3_prefix | regex_replace('^/+|/+$', '') | quote }}

case "$scan_type" in
  malware-scan)
    scan_suffix=
    ;;
  vuln-scan)
    scan_suffix=/wp
    ;;
  *)
    printf 'Usage: %s {malware-scan|vuln-scan}\n' "$0" >&2
    exit 64
    ;;
esac
readonly scan_suffix

scan_candidates=(
{% for site, config in wordpress_sites | dictsort %}
  {{ (www_root ~ '/' ~ site ~ '/' ~
      (config.current_path | default('current')) ~ '/' ~
      (config.public_path | default('web'))) | quote }}
{% endfor %}
)

if ! read -r timestamp date_path < <(date -u '+%Y%m%dT%H%M%SZ %Y/%m/%d'); then
  printf 'Failed to construct the S3 object key\n' >&2
  exit 1
fi
readonly timestamp date_path
readonly key_prefix="${prefix:+${prefix}/}${environment}/${scan_type}/${date_path}"
readonly result_uri="s3://${bucket}/${key_prefix}/${timestamp}.csv"
readonly log_uri="s3://${bucket}/${key_prefix}/${timestamp}.log"
readonly failure_prefix="${prefix:+${prefix}/}${environment}/failed/${scan_type}/${date_path}"

if ! temp_dir="$(mktemp -d)"; then
  printf 'Failed to create temporary scan directory\n' >&2
  exit 1
fi
result_path="${temp_dir}/results.csv"
log_path="${temp_dir}/diagnostics.log"

cleanup() {
  if ! rm -f "$result_path" "$log_path" || ! rmdir "$temp_dir"; then
    printf 'Failed to remove temporary scan files at %s\n' "$temp_dir" >&2
  fi
}
trap cleanup EXIT

scan_status=0
if ! exec 9>"/var/cache/wordfence/${scan_type}.lock"; then
  printf 'Failed to open the Wordfence %s lock\n' "$scan_type" >> "$log_path"
  scan_status=73
else
  lock_status=0
  /usr/bin/flock --nonblock --conflict-exit-code 75 9 2>> "$log_path" ||
    lock_status=$?
  if ((lock_status == 75)); then
    printf 'Another Wordfence %s is already running\n' "$scan_type" >> "$log_path"
    scan_status=75
  elif ((lock_status != 0)); then
    printf 'Failed to acquire the Wordfence %s lock with status %d\n' \
      "$scan_type" "$lock_status" >> "$log_path"
    scan_status="$lock_status"
  fi
fi

scan_arguments=()
if ((scan_status == 0)); then
  for candidate in "${scan_candidates[@]}"; do
    path="${candidate}${scan_suffix}"
    if [[ -d "$path" ]]; then
      scan_arguments+=("$path")
    else
      printf 'Skipping unavailable scan path: %s\n' "$path" >> "$log_path"
    fi
  done

  if [[ -z "${scan_arguments[0]+present}" ]]; then
    printf 'No deployed WordPress sites are available to scan\n' >> "$log_path"
    scan_status=66
  else
    /usr/local/bin/wordfence "$scan_type" \
      --configuration /etc/wordfence/wordfence-cli.ini \
      --accept-terms \
      --no-allow-io-errors \
      --no-color \
      --output-format csv \
      --output-headers \
      --output-path "$result_path" \
      "${scan_arguments[@]}" 2>> "$log_path" ||
      scan_status=$?
  fi
fi

if ((scan_status != 0)); then
  failure_log_uri="s3://${bucket}/${failure_prefix}/${timestamp}-scan-${scan_status}.log"
  if ! /usr/local/bin/aws s3 cp \
    "$log_path" "$failure_log_uri" --only-show-errors; then
    printf 'Wordfence %s failed and its diagnostic upload also failed\n' \
      "$scan_type" >&2
    exit 1
  fi
  printf 'Wordfence %s failed with status %d\n' \
    "$scan_type" "$scan_status" >&2
  exit "$scan_status"
fi

if ! /usr/local/bin/aws s3 cp \
  "$log_path" "$log_uri" --only-show-errors; then
  printf 'Failed to upload Wordfence %s diagnostics\n' "$scan_type" >&2
  exit 1
fi

if ! /usr/local/bin/aws s3 cp \
  "$result_path" "$result_uri" --only-show-errors; then
  printf 'Failed to upload Wordfence %s results\n' "$scan_type" >&2
  exit 1
fi
