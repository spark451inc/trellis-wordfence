#!/usr/bin/env bash
# Managed by Ansible (Trellis-WordFence-Cli); do not edit manually.
# Prefer: systemctl start wordfence-{malware,vuln}-scan.service

set -uo pipefail

if (($# != 1)); then
  printf 'Usage: %s {malware-scan|vuln-scan}\n' "$0" >&2
  exit 64
fi

readonly scan_type="$1"
readonly bucket={{ wordfence_s3_bucket | quote }}
readonly environment={{ env | quote }}
readonly prefix={{ wordfence_s3_prefix | regex_replace('^/+|/+$', '') | quote }}
readonly started_at="${SECONDS}"

case "$scan_type" in
  malware-scan)
    scan_suffix=
    kuma_url={{ wordfence_malware_scan_uptime_kuma_push_url | quote }}
    ;;
  vuln-scan)
    scan_suffix=/wp
    kuma_url={{ wordfence_vuln_scan_uptime_kuma_push_url | quote }}
    ;;
  *)
    printf 'Usage: %s {malware-scan|vuln-scan}\n' "$0" >&2
    exit 64
    ;;
esac
readonly scan_suffix kuma_url

# Rendered at provision time from wordpress_sites.
scan_candidates=(
{% for site, config in wordpress_sites | dictsort %}
  {{ (www_root ~ '/' ~ site ~ '/' ~
      (config.current_path | default('current')) ~ '/' ~
      (config.public_path | default('web'))) | quote }}
{% endfor %}
)

{# Nothing below is templated; raw mode keeps Jinja from reading bash's ${#array[@]} as a comment tag. #}
{% raw %}
log() {
  printf 'wordfence %s: %s\n' "$scan_type" "$*"
}

notify_kuma() {
  local status="$1"
  local message="$2"

  [[ -n "$kuma_url" ]] || return 0

  if ! /usr/bin/curl \
    --fail \
    --silent \
    --show-error \
    --max-time 15 \
    --get \
    --data-urlencode "status=${status}" \
    --data-urlencode "msg=${message}" \
    --data-urlencode "ping=$(((SECONDS - started_at) * 1000))" \
    "${kuma_url%%\?*}" >/dev/null; then
    log "WARNING: Uptime Kuma notification failed"
  fi
}

fail() {
  local status="$1"
  shift
  log "ERROR: $*"
  notify_kuma down "Wordfence ${scan_type} (${environment}) failed with status ${status}: $*"
  exit "$status"
}

if ! read -r timestamp date_path < <(date -u '+%Y%m%dT%H%M%SZ %Y/%m/%d'); then
  fail 1 "failed to construct the S3 object key"
fi
readonly result_uri="s3://${bucket}/${prefix:+${prefix}/}${environment}/${scan_type}/${date_path}/${timestamp}.csv"

if ! temp_dir="$(mktemp -d)"; then
  fail 1 "failed to create a temporary results directory"
fi
readonly result_path="${temp_dir}/results.csv"
trap 'rm -rf -- "$temp_dir"' EXIT

scan_paths=()
missing=()
for candidate in "${scan_candidates[@]}"; do
  path="${candidate}${scan_suffix}"
  if [[ -d "$path" ]]; then
    scan_paths+=("$path")
  else
    log "WARNING: skipping unavailable scan path: ${path}"
    missing+=("$path")
  fi
done

skipped=
if ((${#missing[@]} > 0)); then
  skipped="; skipped ${#missing[@]} unavailable path(s)"
fi

if ((${#scan_paths[@]} == 0)); then
  fail 66 "no deployed WordPress sites are available to scan${skipped}"
fi

log "Starting scan of ${#scan_paths[@]} path(s)${skipped}"

# systemd signals the whole cgroup on timeout, so wordfence stops on its own;
# the trap only keeps this script alive long enough to report the result.
trap ':' TERM

/usr/local/bin/wordfence "$scan_type" \
  --configuration /etc/wordfence/wordfence-cli.ini \
  --accept-terms \
  --no-allow-io-errors \
  --no-color \
  --output-format csv \
  --output-headers \
  --output-path "$result_path" \
  "${scan_paths[@]}"
scan_status=$?

if ((scan_status != 0)); then
  fail "$scan_status" "Wordfence CLI exited with status ${scan_status}${skipped}"
fi

if ! /usr/local/bin/aws s3 cp "$result_path" "$result_uri" --only-show-errors; then
  fail 1 "failed to upload results to ${result_uri}${skipped}"
fi

elapsed=$((SECONDS - started_at))
log "Uploaded results to ${result_uri} in ${elapsed}s${skipped}"
notify_kuma up "Wordfence ${scan_type} (${environment}) succeeded in ${elapsed}s${skipped}"
{% endraw %}
