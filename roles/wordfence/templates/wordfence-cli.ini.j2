# Wordfence CLI configuration
# Managed by Ansible — do not edit manually.
# Reference: https://github.com/wordfence/wordfence-cli/blob/main/docs/Configuration.md

[DEFAULT]
license = {{ wordfence_license }}
cache_directory = {{ wordfence_cache_dir }}
cache = on
banner = off
color = off
{% if wordfence_email %}
email = {{ wordfence_email }}
{% if wordfence_email_from %}
email_from = {{ wordfence_email_from }}
{% endif %}
{% if wordfence_smtp_host %}
smtp_host = {{ wordfence_smtp_host }}
smtp_port = {{ wordfence_smtp_port }}
smtp_tls_mode = {{ wordfence_smtp_tls_mode }}
{% if wordfence_smtp_user %}
smtp_user = {{ wordfence_smtp_user }}
{% endif %}
{% if wordfence_smtp_password %}
# Note: This file contains a sensitive SMTP credential. Protect with mode 0640.
smtp_password = {{ wordfence_smtp_password }}
{% endif %}
{% endif %}
{% endif %}

[malware-scan]
output_format = {{ wordfence_malware_scan_output_format }}
output_path = {{ wordfence_malware_scan_output_path }}
workers = 2
chunk_size = 1000

[vuln-scan]
output_format = {{ wordfence_vuln_scan_output_format }}
output_path = {{ wordfence_vuln_scan_output_path }}
